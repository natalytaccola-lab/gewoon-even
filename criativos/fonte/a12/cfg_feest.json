["feest", 10.8, "c1.style.opacity=1-cl((t-4.6)/0.3);c2.style.opacity=cl((t-5.0)/0.3);const f=cl((t-8.0)/0.5);fim.style.opacity=f;fp.style.opacity=cl((t-9.0)/0.35);document.querySelectorAll('.cap').forEach(e=>e.style.opacity=1-f);", "<div class=\"cap\" style=\"top:220px\"><div id=\"c1\">Ze zit midden in een paniekaanval.</div></div><div class=\"cap\" style=\"top:220px\"><div id=\"c2\" style=\"opacity:0\">Niemand heeft iets&nbsp;door.</div></div>"]